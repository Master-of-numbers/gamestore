root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 2
max_line_length = 100

[*.{yml,yaml,json,md,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[mvnw.cmd]
end_of_line = crlf

[{mvnw,.mvn/**}]
indent_style = unset
indent_size = unset
